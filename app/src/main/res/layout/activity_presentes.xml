<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/txtContador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/margem_tela"
        android:textColor="@color/azul_portaria"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPresentes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/txtContador"
        app:layout_constraintBottom_toTopOf="@id/btnLerQr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/grupoVazio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:gravity="center"
        android:text="@string/vazio_presentes"
        android:textColor="@color/cinza_texto"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txtContador"
        app:layout_constraintBottom_toTopOf="@id/btnLerQr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLerQr"
        android:layout_width="0dp"
        android:layout_height="@dimen/altura_botao"
        android:layout_margin="@dimen/margem_tela"
        android:text="@string/btn_ler_qr"
        android:textColor="@android:color/black"
        app:backgroundTint="@color/amarelo_seguranca"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>